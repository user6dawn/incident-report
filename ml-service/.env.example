# Supabase > Project Settings > API. The service-role key bypasses security rules:
# keep it on the server only, never in the Next.js app or in Git.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Must match ML_API_KEY in the Next.js .env.local
ML_API_KEY=choose-a-long-random-string

# Expected share of unusual reports (0.05 = 5%)
CONTAMINATION=0.05
MIN_INCIDENTS=20
